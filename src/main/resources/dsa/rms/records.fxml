<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="768.0" prefWidth="1024.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dsa.controller.RecordsController">
    <children>
        <Label prefHeight="40.0" prefWidth="1123.0" text="Patient Records" textAlignment="CENTER" wrapText="true">
         <font>
            <Font size="28.0" />
         </font></Label>
      <TableView fx:id="RecordTable" prefHeight="672.0" prefWidth="984.0">
        <columns>
          <TableColumn fx:id="colId" minWidth="50.0" prefWidth="150.0" text="ID" />
          <TableColumn fx:id="colName" minWidth="50.0" prefWidth="150.0" text="Name" />
            <TableColumn fx:id="colAge" minWidth="50.0" prefWidth="150.0" text="Age" />
            <TableColumn fx:id="colStatus" minWidth="50.0" prefWidth="150.0" text="Status" />
            <TableColumn fx:id="colUrgency" minWidth="50.0" prefWidth="150.0" text="Urgency" />
            <TableColumn fx:id="colDuration" minWidth="50.0" prefWidth="150.0" text="Duration" />
        </columns>
      </TableView>
      <ButtonBar centerShape="false" prefHeight="40.0" prefWidth="973.0">
        <buttons>
          <Button fx:id="sortButton" mnemonicParsing="false" onAction="#sortRecords" text="Sort" />
            <Button fx:id="selectRecord" layoutX="645.0" layoutY="17.0" mnemonicParsing="false" onMouseClicked="#onSelectButtonClicked" text="Select" />
              <Button fx:id="secondaryButton" onAction="#switchToPrimary" text="Switch to Primary View" />
        </buttons>
      </ButtonBar>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
