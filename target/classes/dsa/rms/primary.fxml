<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="768.0" prefWidth="1024.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dsa.controller.PrimaryController">
   <children>
      <Label text="Primary View">
         <font>
            <Font size="30.0" />
         </font></Label>
      <SplitPane dividerPositions="0.500578034682081" prefHeight="613.0" prefWidth="1031.0">
        <items>
          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="560.0" prefWidth="489.0">
               <children>
                  <Label alignment="CENTER" prefHeight="42.0" prefWidth="489.0" text="Patient Record">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <VBox layoutY="41.0" prefHeight="566.0" prefWidth="489.0">
                     <children>
                        <!--<ComboBox editable="true" prefWidth="150.0" promptText="Some text" />-->
                        <TextField fx:id="txtPatientId" layoutX="10.0" layoutY="10.0" />
                        <TextField fx:id="txtPatientName" layoutX="10.0" layoutY="254.0" />
                        <TextField fx:id="txtPatientAge" layoutX="10.0" layoutY="280.0" />
                        <TextField fx:id="txtPatientStatus" layoutX="10.0" layoutY="306.0" />
                     </children>
                  </VBox>
               </children>
            </AnchorPane>
          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="158.0" prefWidth="410.0">
               <children>
                  <SplitPane dividerPositions="0.5" orientation="VERTICAL" prefHeight="609.0" prefWidth="489.0">
                    <items>
                      <AnchorPane minHeight="0.0" minWidth="0.0">
                           <children>
                              <TableView fx:id="DepartmentTable" layoutY="51.0" prefHeight="247.0" prefWidth="487.0">
                                <columns>
                                  <TableColumn fx:id="colId" editable="false" prefWidth="85.0" text="ID" />
                                  <TableColumn fx:id="colName" editable="false" prefWidth="400.0" text="Name" />
                                </columns>
                              </TableView>
                           </children></AnchorPane>
                      <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="100.0" prefWidth="160.0">
                           <children>
                              <Canvas fx:id="canvas" height="284.0" width="469.0" />
                           </children></AnchorPane>
                    </items>
                  </SplitPane>
                  <Label alignment="CENTER" prefHeight="42.0" prefWidth="428.0" text="Department">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
               </children>
            </AnchorPane>
        </items>
      </SplitPane>
      <ButtonBar prefHeight="40.0" prefWidth="200.0">
        <buttons>
            <Button fx:id="scheduleButton" onAction="#switchToSecondary" text="Switch to Schedule View" />
            <Button fx:id="recordsButton" onAction="#switchToThird" text="Switch to Records View" />
        </buttons>
      </ButtonBar>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
