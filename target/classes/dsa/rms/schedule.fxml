<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="768.0" prefWidth="1024.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dsa.controller.ScheduleController">
    <children>
        <Label text="Schedule View">
         <font>
            <Font size="27.0" />
         </font></Label>
      <TextField fx:id="txtHighest" />
      <Pane prefHeight="539.0" prefWidth="984.0">
         <children>
            <TextArea fx:id="txtScheduleOutput" prefHeight="486.0" prefWidth="984.0" />
         </children></Pane>
      <ButtonBar prefHeight="40.0" prefWidth="200.0">
        <buttons>
          <Button fx:id="seletctHigh" mnemonicParsing="false" onMouseClicked="#onSelectButtonClicked" text="Select" />
              <Button fx:id="secondaryButton" onAction="#switchToPrimary" text="Switch to Primary View" />
        </buttons>
      </ButtonBar>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
